# =============================================================================
# EMOZION TYPEBOT FORK — Variables de entorno
# =============================================================================
# Copia este archivo como .env y rellena los valores.
# Las variables marcadas con [REQUERIDA] rompen el arranque si no están.
# Las marcadas con [BUILD] deben pasarse como --build-arg al docker build.
# Las marcadas con [RUNTIME] se inyectan en Portainer al desplegar el container.
# =============================================================================


# =============================================================================
# BLOQUE 1 — INTEGRACIÓN EMOZION (variables del fork, nuevas)
# =============================================================================

# [REQUERIDA] [BUILD + RUNTIME]
# URL pública del CRM EmozionBot. Se usa en dos lugares:
#   1. En next.config.mjs para generar el header CSP "frame-ancestors",
#      que permite que el builder de Typebot sea embebido en un Iframe
#      desde ese dominio. Se hornea en el bundle en tiempo de compilación.
#   2. En el endpoint /api/auth/sso para verificar que el SSO está configurado.
# Formato: URL completa sin barra final.
EMOZION_CRM_URL=https://crm.emozion.com

# [REQUERIDA] [RUNTIME]
# Clave secreta compartida entre EmozionBot (Rails) y este builder.
# EmozionBot la usa para firmar el JWT de SSO con HMAC-SHA256.
# Este fork la usa para verificar ese JWT en /api/auth/sso.
# REQUISITO: mínimo 32 caracteres. Genera una con:
#   openssl rand -hex 32
# NUNCA compartas ni versiones este valor.
EMOZION_SHARED_SECRET=cambia_esto_por_64_caracteres_hexadecimales_generados_con_openssl

# [BUILD + RUNTIME]
# Activa el modo white-label de Emozion en la UI del builder.
# Cuando es "true":
#   - Oculta la lista de workspaces (WorkspaceDropdown)
#   - Oculta el botón "Crear nuevo workspace"
#   - Oculta el botón de soporte externo (enlaza a docs.typebot.io)
#   - Oculta los badges de plan (FREE, PRO, etc.)
# IMPORTANTE: al ser una variable NEXT_PUBLIC_, queda horneada en el bundle
# JavaScript del cliente durante el build. Pasarla en runtime solo tiene
# efecto en el servidor. Para el comportamiento de la UI, debe estar
# presente en el --build-arg del docker build.
# Valores válidos: "true" | "false"
NEXT_PUBLIC_EMOZION_MODE=true

# [RUNTIME]
# Plan por defecto asignado a cada workspace creado en este fork.
# UNLIMITED desactiva todos los límites de chats, seats y storage,
# y suprime la llamada a enforceFreeTierLimits() en la creación de workspaces.
# Valores válidos: FREE | STARTER | PRO | LIFETIME | UNLIMITED
# Para el fork de Emozion, usar siempre UNLIMITED.
DEFAULT_WORKSPACE_PLAN=UNLIMITED


# =============================================================================
# BLOQUE 2 — NÚCLEO (requeridas para que el proceso arranque)
# =============================================================================

# [REQUERIDA] [RUNTIME]
# Cadena de exactamente 32 caracteres usada para cifrar credenciales
# (tokens de OAuth, claves de API de integraciones) en la base de datos.
# Si cambias este valor, TODAS las credenciales guardadas quedan corruptas.
# Genera una con: openssl rand -base64 24 | head -c 32
ENCRYPTION_SECRET=cambia_esto_por_exactamente_32car

# [REQUERIDA] [RUNTIME]
# URL de conexión a PostgreSQL.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
# Para Docker Compose con la red interna de Portainer:
#   HOST = nombre del servicio de la base de datos (ej: typebot-db)
# Para PostgreSQL externo (el de Chatwoot si lo compartís):
#   HOST = IP o hostname del servidor Postgres
DATABASE_URL=postgresql://postgres:password@typebot-db:5432/typebot

# [REQUERIDA] [RUNTIME]
# URL pública del builder (esta app). NextAuth la usa para construir
# las URLs de callback de OAuth y para las sesiones.
# Debe coincidir EXACTAMENTE con la URL desde la que se accede al builder,
# incluyendo el protocolo (https://) y sin barra final.
NEXTAUTH_URL=https://typebot.tudominio.com

# [REQUERIDA] [BUILD + RUNTIME]
# URL pública del viewer (el runtime que ejecuta los bots para usuarios finales).
# Si en esta etapa solo desplegás el builder (sin el viewer), podés poner
# la misma URL del builder como placeholder. Los bots no serán ejecutables
# públicamente hasta que despliegues el viewer.
NEXT_PUBLIC_VIEWER_URL=https://bot.tudominio.com

# [REQUERIDA] [RUNTIME]
# Flag de Node.js necesario para que el servidor Next.js standalone arranque
# correctamente. Sin esto puede haber errores de snapshot en producción.
NODE_OPTIONS=--no-node-snapshot


# =============================================================================
# BLOQUE 3 — ACCESO Y REGISTRO
# =============================================================================

# [RUNTIME]
# Email(s) de administrador del sistema, separados por coma.
# Los usuarios con estos emails reciben automáticamente Plan.UNLIMITED
# (independientemente de DEFAULT_WORKSPACE_PLAN) y ven el panel de admin.
# En el fork de Emozion este campo es secundario (DEFAULT_WORKSPACE_PLAN=UNLIMITED
# ya cubre todos los workspaces), pero útil para identificar al super-admin.
ADMIN_EMAIL=admin@emozion.com

# [RUNTIME]
# Si es "true", desactiva el formulario de registro público.
# Los usuarios solo podrán acceder mediante el endpoint SSO de Emozion.
# Recomendado: "true" en producción para que nadie cree cuentas manuales
# que queden fuera del flujo de EmozionBot.
# Valores: "true" | "false"
DISABLE_SIGNUP=true


# =============================================================================
# BLOQUE 4 — EMAIL / SMTP
# (Necesario para magic links, notificaciones de colaboración e invitaciones)
# =============================================================================

# [RUNTIME]
# Nombre del servidor SMTP saliente.
SMTP_HOST=smtp.tuproveedor.com

# [RUNTIME]
# Puerto SMTP. 587 para STARTTLS, 465 para SSL, 25 sin cifrado.
SMTP_PORT=587

# [RUNTIME]
# Credenciales de la cuenta SMTP.
SMTP_USERNAME=no-reply@emozion.com
SMTP_PASSWORD=tu_password_smtp

# [RUNTIME]
# Si tu servidor SMTP no requiere autenticación (ej: relay interno), pon "true".
# Valores: "true" | "false"
SMTP_AUTH_DISABLED=false

# [RUNTIME]
# Fuerza conexión SSL/TLS directa (puerto 465). Para STARTTLS (587) dejar "false".
# Valores: "true" | "false"
SMTP_SECURE=false

# [BUILD + RUNTIME]
# Dirección "De:" que aparece en los emails enviados por el sistema.
# Formato: "Nombre Visible <email@dominio.com>" o simplemente "email@dominio.com"
NEXT_PUBLIC_SMTP_FROM=EmozionBot <no-reply@emozion.com>


# =============================================================================
# BLOQUE 5 — ALMACENAMIENTO DE ARCHIVOS (S3 / MinIO)
# (Necesario para subida de imágenes, audios, archivos en los bots)
# =============================================================================

# [RUNTIME] — Clave de acceso de tu bucket S3 o instancia MinIO.
S3_ACCESS_KEY=tu_access_key

# [RUNTIME] — Clave secreta correspondiente.
S3_SECRET_KEY=tu_secret_key

# [RUNTIME] — Nombre del bucket. Se creará automáticamente si no existe.
S3_BUCKET=typebot

# [RUNTIME] — Endpoint de tu servidor S3/MinIO.
# Para MinIO en Docker Compose interno: http://minio:9000
# Para AWS S3: no definir este campo (usa el endpoint por defecto de AWS).
S3_ENDPOINT=http://minio:9000

# [RUNTIME] — Puerto del endpoint (solo si no está incluido en S3_ENDPOINT).
# S3_PORT=9000

# [RUNTIME] — Región AWS (solo para AWS S3 real, no para MinIO).
# S3_REGION=us-east-1

# [RUNTIME]
# Si el endpoint usa HTTPS. Para MinIO interno sin certificado, usar "false".
# Para AWS S3 o MinIO con TLS, usar "true".
# Valores: "true" | "false"
S3_SSL=false

# [RUNTIME]
# Si los archivos son accesibles públicamente por una URL personalizada
# (ej: MinIO detrás de Caddy con dominio propio), definir aquí la URL base.
# Dejar vacío si el bucket no es público o si usás pre-signed URLs.
# S3_PUBLIC_CUSTOM_DOMAIN=https://archivos.tudominio.com


# =============================================================================
# BLOQUE 6 — REDIS
# (Opcional, pero recomendado para rate limiting y sesiones distribuidas)
# =============================================================================

# [RUNTIME]
# URL de conexión a Redis. Si no se define, el sistema funciona sin caché
# distribuida (aceptable para instancia única en Portainer).
# Para Redis en Docker Compose interno: redis://typebot-redis:6379
# Para Redis con contraseña: redis://:password@host:6379
REDIS_URL=redis://typebot-redis:6379


# =============================================================================
# BLOQUE 7 — AUTENTICACIÓN SOCIAL (todas opcionales)
# Solo relevantes si querés ofrecer login adicional al SSO de Emozion.
# Para el uso con Iframe + SSO exclusivo, podés dejar todo este bloque vacío.
# =============================================================================

# Google OAuth — https://console.cloud.google.com/
# GOOGLE_AUTH_CLIENT_ID=
# GOOGLE_AUTH_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# GitLab OAuth
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITLAB_BASE_URL=https://gitlab.com
# GITLAB_NAME=GitLab
# GITLAB_REQUIRED_GROUPS=mi-grupo

# Azure AD / Microsoft Entra ID
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=

# Keycloak
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_REALM=
# KEYCLOAK_BASE_URL=https://keycloak.tudominio.com

# OAuth personalizado (cualquier proveedor compatible con OpenID Connect)
# CUSTOM_OAUTH_NAME=Mi Proveedor
# CUSTOM_OAUTH_CLIENT_ID=
# CUSTOM_OAUTH_CLIENT_SECRET=
# CUSTOM_OAUTH_WELL_KNOWN_URL=https://proveedor.com/.well-known/openid-configuration
# CUSTOM_OAUTH_SCOPE=openid profile email
# CUSTOM_OAUTH_USER_ID_PATH=sub
# CUSTOM_OAUTH_USER_EMAIL_PATH=email
# CUSTOM_OAUTH_USER_NAME_PATH=name
# CUSTOM_OAUTH_USER_IMAGE_PATH=picture


# =============================================================================
# BLOQUE 8 — WHATSAPP / META
# (Relevante si los bots de Emozion se ejecutan por WhatsApp)
# =============================================================================

# [RUNTIME]
# Token del usuario del sistema en Meta Business Suite.
# Requerido para enviar y recibir mensajes de WhatsApp via la Cloud API.
# META_SYSTEM_USER_TOKEN=

# ID del número de teléfono usado para enviar previews de bots en WhatsApp.
# WHATSAPP_PREVIEW_FROM_PHONE_NUMBER_ID=

# Nombre de la plantilla de WhatsApp usada para iniciar conversaciones de preview.
# WHATSAPP_PREVIEW_TEMPLATE_NAME=typebot_preview
# WHATSAPP_PREVIEW_TEMPLATE_LANG=es


# =============================================================================
# BLOQUE 9 — INTEGRACIONES DE MEDIOS (todas opcionales)
# =============================================================================

# Google Sheets (para el bloque de integración con hojas de cálculo)
# GOOGLE_SHEETS_CLIENT_ID=
# GOOGLE_SHEETS_CLIENT_SECRET=
# NEXT_PUBLIC_GOOGLE_SHEETS_API_KEY=

# Google Fonts (para selección de fuentes en el tema del bot)
# NEXT_PUBLIC_GOOGLE_FONTS_API_KEY=

# Giphy (para el selector de GIFs en el editor)
# NEXT_PUBLIC_GIPHY_API_KEY=

# Unsplash (para el selector de imágenes en el editor)
# NEXT_PUBLIC_UNSPLASH_APP_NAME=
# NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=

# Pexels (para el selector de videos en el editor)
# NEXT_PUBLIC_PEXELS_API_KEY=


# =============================================================================
# BLOQUE 10 — OBSERVABILIDAD (todas opcionales)
# =============================================================================

# Sentry — seguimiento de errores en producción
# SENTRY_DSN=https://clave@sentry.io/proyecto
# SENTRY_AUTH_TOKEN=
# SENTRY_PROJECT=
# SENTRY_ORG=

# PostHog — analytics de producto
# NEXT_PUBLIC_POSTHOG_KEY=phc_clave
# POSTHOG_API_HOST=https://us.posthog.com
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=

# OpenTelemetry — trazas distribuidas (Jaeger, Grafana Tempo, etc.)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer token
# OTEL_EXPORTER_OTLP_SIGNALS=traces


# =============================================================================
# BLOQUE 11 — VARIABLES QUE NO APLICAN A ESTE FORK
# (Documentadas para que no queden dudas. No descomentar.)
# =============================================================================

# STRIPE — no aplica: el billing está desactivado con DEFAULT_WORKSPACE_PLAN=UNLIMITED
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_STARTER_PRICE_ID=
# STRIPE_PRO_PRICE_ID=
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

# VERCEL — no aplica: el despliegue es en Portainer/Docker, no en Vercel
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=

# TOLGEE — no aplica: es el sistema de traducción en la nube del upstream
# NEXT_PUBLIC_TOLGEE_API_KEY=

# PARTYKIT — no aplica: es el servicio de colaboración en tiempo real del upstream
# NEXT_PUBLIC_PARTYKIT_HOST=

# INNGEST — no aplica: es el sistema de workflows serverless del upstream
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# SLEEKPLAN — no aplica: es el widget de feedback/roadmap del upstream
# SLEEKPLAN_SSO_KEY=
